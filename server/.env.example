NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=https://example.com
DATABASE_URL=postgres://xingxuan:change_me@127.0.0.1:5432/xingxuan
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_DEV_LOGIN=true
ADMIN_ACCESS_TOKEN_TTL_SECONDS=28800
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace_with_at_least_12_characters
ADMIN_SEED_DISPLAY_NAME=系统管理员

# 微信小程序登录
WX_APP_ID=
WX_APP_SECRET=

# 微信支付 API v3；生产开启支付时必填
WX_MCH_ID=
WX_MCH_SERIAL_NO=
WX_MCH_PRIVATE_KEY_PATH=/run/secrets/wechat_mch_private_key.pem
WX_PLATFORM_CERT_PATH=/run/secrets/wechat_platform_cert.pem
WX_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
